# Target: ESP32-WROOM-32D (dual-mode Bluetooth: Classic + BLE)
CONFIG_IDF_TARGET="esp32"

# ---- Bluetooth: dual mode (Classic BT + BLE), Bluedroid host stack ----
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=y

# ---- HID Host (Classic BT), used by the DualSense backend ----
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y

# ESP32 (original) supports Bluetooth 4.2, not 5.0
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16

# Bluedroid (Classic + BLE) does not fit in the default ~1 MB app partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size: match the 16 MB GigaDevice flash on this WROOM-32D module
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 1 ms tick so the rotary-encoder self-test can sample at 200 Hz via
# vTaskDelayUntil (the default 100 Hz rounds a 5 ms period to 0 ticks).
CONFIG_FREERTOS_HZ=1000
